input UserInput {
  id: Long!
  fullName: String
  email: String
  token: String
  password: String
  image: String
}


input TaskInput {
  id: Long!
  title: String!
  description: String!
  taskStatus: String!
  taskPriority: String!
  version: Int!
  taskOrder: Int!
  users: [UserInput!]!
}


type User {
  id: Long
  email: String
  fullName: String
  token: String
  password: String
  image: String
}

type Task {
  id: Long!
  title: String!
  description: String!
  taskStatus: String!
  taskPriority: String!
  version: Int!
  taskOrder: Int!
  users: [User!]!
}

type TasksByStatus {
  status: String;
  tasks: [Task!]!
}

type Query {
    getTaskById(id: Int!): TasksByStatus!
    getTasks(limit: Int!, offset: Int!, description: String): [Task!]!
}

type Mutation {
    createTask(task: TaskInput!): Task
    updateTask(id: Int!, task: TaskInput!): Task
    deleteTask(id: Int!, version: Int!): Task
    dragTask(taskId: Int!, taskStatus: String!, taskOrder: Int!, taskVersion: Int): OptionalTask
}
